<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ach_payment_settings_view_form" model="ir.ui.view">
        <field name="name">Advance Payments in Config Settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Sales Payments" name="ach_payment_sale_setting_container">
                    <setting id="status_for_payment_setting" string="Sales States"
                        help="Establish in which sales states advance payments can be added">
                        <field name="status_for_payment" class="o_light_label" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
